# Resend (sending-access key only)
RESEND_API_KEY=
# Must be the email you signed up to Resend with while using the test sender
TO_EMAIL=
# Optional until you verify a domain in Resend
FROM_EMAIL=Day by Datum <onboarding@resend.dev>

# Long random strings. Generate each with:  openssl rand -base64 48
APP_SECRET=
CRON_SECRET=
READ_TOKEN=
# The password you type to open the dashboard
APP_PASSWORD=

# Optional. Defaults to the production URL Vercel provides.
APP_URL=

# Set automatically when you add the Upstash Redis integration:
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (or KV_REST_API_URL / KV_REST_API_TOKEN)
